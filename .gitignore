# IDE / Редакторы
.vscode/
.idea/

# Виртуальное окружение
venv/
.venv/

# Python: сгенерированные файлы
*.pyc
__pycache__/

# --- КРИТИЧЕСКАЯ БЕЗОПАСНОСТЬ (НЕ ЗАГРУЖАТЬ!) ---
.env                        # Файл с переменными окружения (токен, ID чатов)
published_posts.json        # Файл сохранения данных о постах (персистентность)
pending_posts.json          # Если используется для хранения ожидающих постов

